# f1-microsector-pipeline — service configuration template.
#
# Copy to .env next to this file and replace every CHANGE_ME with a real value:
#
#   cp .env.example .env
#
# .env is gitignored (**/.env) and must never be committed. This file is
# versioned and is updated in the same commit as .env whenever a key changes.
# Passwords: generate them, do not invent them, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# Prefixes every container, network and Compose resource for this project.
COMPOSE_PROJECT_NAME=f1-microsector

# --- Postgres -----------------------------------------------------------------
# Admin role: owns the schema, runs migrations and loads (F005).
POSTGRES_USER=f1_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=f1_microsector
# Host port. 55432 rather than 5432 so a local PostgreSQL install on the
# host cannot collide with the container.
POSTGRES_PORT=55432
# Host interface the port is published on. 127.0.0.1 is localhost: this
# machine only, on any Wi-Fi or with no network at all. Connection string
# from the conda env: postgresql://f1_admin:<password>@localhost:55432/f1_microsector
# Set 0.0.0.0 only to reach the database from another device on the same LAN.
POSTGRES_BIND_ADDRESS=127.0.0.1

# Read-only role: created on first initialisation, used by Grafana and by any
# other dashboard consumer. It can SELECT and nothing else.
POSTGRES_READONLY_USER=f1_readonly
POSTGRES_READONLY_PASSWORD=CHANGE_ME

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3000
# 127.0.0.1 is localhost: the dashboard opens at http://localhost:3000 on this
# machine. Set 0.0.0.0 only to open it from another device (a tablet) on the
# same LAN, at http://<this-machine-ip>:3000.
GRAFANA_BIND_ADDRESS=127.0.0.1

# --- Airflow (F006) -----------------------------------------------------------
# Metadata database, on the same Postgres instance as the warehouse (D9). The
# entrypoint creates it on first start if it is absent.
AIRFLOW_DB=airflow
# Web UI login. Airflow's SimpleAuthManager stores this in a plaintext JSON
# file under data/airflow/ -- it is dev-only by design, which is why the port
# below stays on loopback.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_PORT=8080
# 127.0.0.1 is localhost: the UI opens at http://localhost:8080 on this machine
# and answers nothing else. Do not expose this one to a LAN.
AIRFLOW_BIND_ADDRESS=127.0.0.1

# --- Spark (F013) --------------------------------------------------------
# Connect server for the resampling executor, `pipeline` profile only.
SPARK_CONNECT_PORT=15002
# Loopback by default: the Connect server has no authentication.
SPARK_BIND_ADDRESS=127.0.0.1

# --- Jupyter (F014) -----------------------------------------------------------
# Exploration only, `dev` profile. The kernel connects to Postgres as the
# read-only role above, so nothing here can write to the warehouse.
# Token for the browser session. Generate it, do not invent it:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
JUPYTER_TOKEN=CHANGE_ME
JUPYTER_PORT=8888
# 127.0.0.1 is localhost: JupyterLab opens at http://localhost:8888 on this
# machine and answers nothing else. A notebook server executes arbitrary code,
# so do not expose this one to a LAN.
JUPYTER_BIND_ADDRESS=127.0.0.1
