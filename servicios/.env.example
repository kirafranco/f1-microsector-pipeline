# ---------------------------------------------------------------------------
# f1-microsector-pipeline — service configuration template
#
# Copy to `.env` in this same folder and replace every CHANGE_ME value:
#     cp .env.example .env
#
# `.env` is gitignored (**/.env) and must never be committed. This file IS
# versioned and must therefore only ever contain dummy values.
#
# Rule: every variable used by docker-compose.yml has an entry here. When one
# is added to `.env`, it is added here in the same commit.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=f1-microsector

# --- Postgres (profile: core) ----------------------------------------------
POSTGRES_DB=f1_microsector
POSTGRES_USER=f1_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST_PORT=5432

# Read-only role used by the dashboard datasource. Dashboards never connect
# with the application user.
POSTGRES_READONLY_USER=f1_readonly
POSTGRES_READONLY_PASSWORD=CHANGE_ME

# --- Grafana (profile: core) -----------------------------------------------
# Never leave these at Grafana's admin/admin default (global CLAUDE.md 2.2).
GF_SECURITY_ADMIN_USER=CHANGE_ME
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_HOST_PORT=3000

# --- Jupyter (profile: dev) ------------------------------------------------
JUPYTER_TOKEN=CHANGE_ME
JUPYTER_HOST_PORT=8888

# --- Spark (profile: pipeline) ---------------------------------------------
# No credentials. spark.local.dir stays on a container-internal path so that
# shuffle spill never lands on a Windows bind mount (D2).
SPARK_LOCAL_DIR=/tmp/spark-local
SPARK_DRIVER_MEMORY=3g

# --- Airflow (profile: orchestration) --------------------------------------
# Metadata DB is a separate database on the project Postgres instance (D9).
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME
AIRFLOW_ADMIN_USER=CHANGE_ME
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_HOST_PORT=8080

# --- Data sources -----------------------------------------------------------
# FastF1 and Jolpica-F1 are open and unauthenticated: no API keys exist for
# either, and none should ever be added here. Any source that required
# credentials would breach the free-and-trusted source policy.
